rules_version = '2';
// ==========================================================================
// CUA Aquarium — Firestore rules theo QUYỀN TRONG VAI TRÒ
//
// Admin tick quyền trong vai trò (app: Quản trị hệ thống › Vai trò). Worker ghi quyền
// hiệu lực vào thẻ đăng nhập của từng người (custom claims):
//   adm: true          -> Admin, toàn quyền
//   q:   ['banhang',…] -> danh sách quyền của nhân viên
//   kh:  true          -> tài khoản bị khóa
// Rules chỉ đọc quyền từ thẻ (không tốn lượt đọc). Không có quyền thì máy chủ KHÔNG
// trả dữ liệu — ẩn trên giao diện chỉ là phụ.
// Bộ khóa quyền phải khớp DANH_SACH_MODULE trong app và KHOA_QUYEN trong worker.
// Worker ghi bằng quyền Admin của Firebase nên không chịu ràng buộc các rule này.
// ==========================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function dn() { return request.auth != null; }
    function toi() { return request.auth.uid; }
    function the() { return request.auth.token; }
    // Admin: theo thẻ; thẻ chưa đồng bộ thì xem hồ sơ (để Admin không tự khóa mình)
    function adm() {
      return dn() && (the().adm == true
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    // Nhân viên đã được cấp quyền (thẻ đã đồng bộ) và không bị khóa
    function nv() { return dn() && the().get('kh', false) != true && (the().get('q', null) is list || the().get('adm', false) == true); }
    function coQ(k) { return nv() && the().get('q', []) is list && k in the().get('q', []); }
    function q(k) { return coQ(k) || adm(); }
    function qMot(ds) { return (nv() && the().get('q', []) is list && the().get('q', []).hasAny(ds)) || adm(); }
    function chiDoi(ds) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(ds); }
    function chiCo(ds) { return request.resource.data.keys().hasOnly(ds); }
    // Chiều thay đổi số tồn: bán chỉ được trừ, nhập/trả chỉ được cộng
    function giam(f) { return request.resource.data.get(f, 0) <= resource.data.get(f, 0); }
    function tang(f) { return request.resource.data.get(f, 0) >= resource.data.get(f, 0); }

    // ===== NGƯỜI DÙNG =====
    // Đọc hồ sơ người khác chỉ khi có việc cần: xếp ca, xem lương mọi người, báo cáo.
    match /users/{uid} {
      allow get: if (dn() && toi() == uid) || qMot(['lichca_xepca', 'luong_xemtatca', 'bc_ngay']);
      allow list: if qMot(['lichca_xepca', 'luong_xemtatca', 'bc_ngay']);
      // Tự đổi mật khẩu: chỉ ghi được mốc đổi mật khẩu của chính mình
      allow update: if adm() || (dn() && toi() == uid && chiDoi(['pwUpdatedAt']));
      allow create, delete: if adm();
    }

    // Hồ sơ riêng (CCCD, địa chỉ): chỉ Admin
    match /ho_so_nv/{uid} {
      allow read, write: if adm();
    }

    // Vai trò: tên + danh sách quyền, không nhạy cảm; app cần để hiện menu
    match /vai_tro/{id} {
      allow read: if nv();
      allow write: if adm();
    }

    // ===== CẤU HÌNH =====
    // cham_cong chứa nội dung QR chấm công: app so mã QR ở máy nên ai chấm công cũng cần đọc.
    match /cau_hinh/{id} {
      allow read: if adm() || (nv() && !(id in ['ket_noi_kol', 'tram_in', 'rules_lich_su']));
      allow write: if adm();
    }
    // settings: đơn giá lương, công thức thưởng, và token kết nối sàn (chỉ Admin)
    match /settings/{id} {
      allow read: if adm() || (id in ['luong_theo_gio', 'cong_thuc_luong'] && q('luong'))
        // Bảng công thức thưởng/trừ: nhân viên cần đọc để thấy thưởng đóng gói trực tiếp
        || (id == 'quy_tac_thuong' && nv());
      allow write: if adm();
    }
    match /bi_mat/{id} {
      allow read, write: if false;
    }

    // ===== HÀNG HÓA =====
    // Thông tin hàng + tồn kho Cửa hàng: nhân viên nào cũng cần (bán hàng, chuyển kho, xuất hủy).
    // Nhân viên chỉ đổi được tồn Cửa hàng theo đúng chiều việc mình làm, và cờ đẩy tồn của Sàn.
    function nhapVao(kho) { return coQ('nh_duyet') && coQ('nh_kho_' + kho); }
    match /skus/{id} {
      // Chỉ người có việc cần tới hàng hóa mới đọc được danh mục (chỉ chấm công thì không)
      allow read: if qMot(['banhang', 'datcoc', 'donbanle', 'checklist', 'nhap', 'xuat', 'hanghoa', 'baocao', 'nhaphang', 'dathang', 'dungnb', 'kiemkho', 'kk_duyet',
        'tmdt_donhang', 'tmdt_hoantra', 'quetdonggoi', 'tmdt_sanpham', 'tmdt_daytonkho']);
      allow create, delete: if adm();
      allow update: if adm()
        || (chiDoi(['tonCuaHang']) && (
              (qMot(['banhang', 'ck_ch_san']) && giam('tonCuaHang'))              // bán, chuyển CH→Sàn: trừ
           || ((qMot(['ck_san_ch', 'dbl_duyettra']) || nhapVao('ch')) && tang('tonCuaHang'))  // chuyển Sàn→CH, trả hàng, nhập: cộng
           || coQ('nhap_sua')))                                                 // sửa/xóa phiếu chuyển: cả hai
        || (coQ('tmdt_daytonkho') && chiDoi(['dayTonKho', 'demTonKho']));
    }
    // Tồn kho Sàn tách riêng: chỉ người có quyền xem kho Sàn / làm Sàn TMĐT mới đọc được.
    // Chuyển kho, xuất hủy, nhập hàng ghi được theo đúng chiều mà không cần đọc.
    match /ton_san/{id} {
      allow read: if qMot(['hh_kho_san', 'dn_kho_san', 'tmdt_donhang', 'tmdt_hoantra', 'quetdonggoi', 'tmdt_sanpham', 'tmdt_daytonkho'])
        // Mã kho chung (hàng để ở quầy, bán cả online): người bán hàng / đặt cọc đọc được tồn để bán tại quầy
        || (qMot(['banhang', 'datcoc']) && resource.data.get('khoChung', false) == true);
      // Trừ Sàn: chuyển Sàn→CH. Cộng Sàn: chuyển CH→Sàn, nhập hàng, nhập lại hàng hoàn.
    // (Xuất hủy: worker trừ / hoàn tồn khi tạo, sửa, xóa phiếu — app không tự đổi.)
      allow create: if adm() || (chiCo(['soLuongTon']) && (
              coQ('nhap_sua')
           || (coQ('ck_san_ch') && request.resource.data.soLuongTon <= 0)
           || ((qMot(['ck_ch_san', 'tmdt_hoantra']) || nhapVao('san')) && request.resource.data.soLuongTon >= 0)));
      allow update: if adm() || (chiDoi(['soLuongTon']) && (
              coQ('nhap_sua')
           || (coQ('ck_san_ch') && giam('soLuongTon'))
           || ((qMot(['ck_ch_san', 'tmdt_hoantra']) || nhapVao('san')) && tang('soLuongTon'))));
      allow delete: if adm();
    }
    match /gia_von/{id} {
      allow read, write: if adm();
    }
    match /nhom_hang/{id} {
      allow read: if nv();
      allow write: if adm();
    }
    // Thẻ kho: xem khi được xem kho; ghi kèm mỗi lần tồn đổi, không sửa/xóa được
    match /the_kho/{id} {
      allow read: if qMot(['hh_kho_ch', 'hh_kho_san']);
      allow create: if nv();
      allow update, delete: if false;
    }

    // ===== BÁN HÀNG =====
    // Không có quyền "xem đơn của mọi người" thì chỉ đọc được đơn mình bán
    match /don_ban_le/{id} {
      // Người duyệt trả hàng cần mở hóa đơn gốc của người khác để duyệt
      allow read: if qMot(['dbl_xemtatca', 'luong_xemtatca', 'dbl_duyettra'])
        || (qMot(['donbanle', 'banhang', 'luong']) && resource.data.nguoiBan.uid == toi());
      allow create: if q('banhang') && request.resource.data.nguoiBan.uid == toi();
      allow update: if adm()
        || (q('dbl_duyettra') && chiDoi(['maHoaDonKiotViet', 'daHuy', 'lanTra', 'tongDaTra']));
      allow delete: if adm();
    }
    match /phieu_tra_hang/{id} {
      allow read: if qMot(['dbl_xemtatca', 'dbl_duyettra'])
        || (q('donbanle') && resource.data.nguoiTao.uid == toi());
      allow create: if q('dbl_trahang') && request.resource.data.nguoiTao.uid == toi()
        && request.resource.data.trangThai == 'cho_duyet';
      allow update: if q('dbl_duyettra');
      allow delete: if adm();
    }
    match /thanh_toan_ban_le/{id} {
      allow read: if q('banhang');
      allow write: if false;
    }
    // Lệnh in: ai bán hàng / in tem gửi được; xem và xử lý hàng đợi là việc của Admin
    // Phiếu đặt cọc: ai làm Đặt cọc đều xem được (để tìm phiếu của khách khi lấy hàng); ghi chỉ qua máy chủ
    match /phieu_dat_coc/{id} {
      allow read: if qMot(['datcoc']);
      allow write: if false;
    }
    match /lenh_in/{id} {
      allow create: if qMot(['banhang', 'datcoc', 'donbanle', 'hh_intem']) && request.resource.data.trangThai == 'cho_in';
      allow read, update, delete: if adm();
    }

    // ===== CHUYỂN KHO / XUẤT HỦY =====
    match /dem_phieu/{id} {
      allow read, write: if qMot(['ck_san_ch', 'ck_ch_san', 'xh_kho_ch', 'xh_kho_san', 'dathang']);
    }
    // Chuyển kho: tạo phiếu đúng chiều mình được cấp. Thống kê (Báo cáo) chỉ đọc.
    match /phieu_chuyenkho/{id} {
      allow read: if qMot(['nhap_xemds', 'nhap_sua', 'bc_tk_nhap']);
      allow create: if adm()
        || (coQ('ck_san_ch') && request.resource.data.get('chieu', '') == 'san_ch')
        || (coQ('ck_ch_san') && request.resource.data.get('chieu', '') == 'ch_san');
      allow update: if q('nhap_sua') || (q('nhap_xuatfile') && chiDoi(['daXuat', 'xuatAt']));
      allow delete: if adm();
    }
    // Xuất hủy: phiếu do worker tạo (kiểm kho + danh mục được hủy, trừ kho KiotViet + app)
    match /phieu_huy/{id} {
      allow read: if qMot(['xuat_xemds', 'xuat_sua', 'xh_duyet', 'luong_xemtatca', 'bc_tk_xuat']);
      allow create: if adm();
      // Sửa / xóa / khôi phục cũng qua worker (kiểm quyền xuat_sua, danh mục, tồn)
      allow update: if adm() || (q('xuat_xuatfile') && chiDoi(['daXuat', 'xuatAt']));
      allow delete: if adm();
    }
    // Ảnh phiếu xuất hủy (mỗi ảnh một tài liệu, worker ghi): ai xem được phiếu hủy thì xem được ảnh
    match /anh_phieu/{id} {
      allow read: if qMot(['xuat_xemds', 'xuat_sua', 'luong_xemtatca', 'bc_tk_xuat'])
        || (resource.data.loai == 'dungnb' && (qMot(['dn_xemds']) || (nv() && resource.data.uid == toi())));
      allow write: if false;
    }

    // Xuất dùng nội bộ: worker ghi (tạo, duyệt, từ chối, hủy). Đọc: người xem danh sách hoặc chính người tạo.
    // Hàng hoàn đã xác nhận (worker ghi): ai có quyền Hàng hoàn xem được lịch sử
    match /hang_hoan/{id} {
      allow read: if qMot(['tmdt_hoantra', 'hanghoan']);
      allow write: if false;
    }
    // Kiểm kho: mọi ghi qua worker (máy chủ lưu tồn lúc đếm, duyệt thì cộng/trừ chênh lệch + KiotViet)
    match /phieu_kiem_kho/{id} {
      allow read: if qMot(['kiemkho', 'kk_duyet']);
      allow write: if false;
    }
    match /phieu_dung_nb/{id} {
      allow read: if qMot(['dn_xemds', 'dn_duyet']) || (nv() && resource.data.uidTao == toi());
      allow write: if false;
    }

    // Nhập hàng (nhóm Hàng hóa, không thuộc Sàn TMĐT nữa). kho: 'ch' | 'san' (phiếu cũ không có = 'san').
    // Phiếu tạm: ai có quyền nhập vào kho đó. Lưu thật (da_luu): phải có thêm quyền duyệt.
    function khoNhapDuoc(d) { return coQ('nh_kho_' + d.get('kho', 'san')); }
    // Phiếu nhập Phụ kiện phải có ảnh hàng hóa (Cá/Tép/Cây tạm thời chưa bắt buộc)
    function anhPhuKien(d) { return d.get('loai', '') != 'phukien' || (d.get('photos', []) is list && d.get('photos', []).size() > 0); }
    match /phieu_nhap_san/{id} {
      // Chỉ đọc phiếu của kho mình được nhập (danh sách trong app lấy qua máy chủ)
      allow read: if adm() || (coQ('nhaphang') && khoNhapDuoc(resource.data));
      allow create: if adm() || (coQ('nhaphang') && khoNhapDuoc(request.resource.data) && anhPhuKien(request.resource.data)
        && (request.resource.data.trangThai == 'tam' || coQ('nh_duyet')));
      allow update: if adm() || (coQ('nhaphang') && resource.data.trangThai == 'tam'
        && khoNhapDuoc(resource.data) && khoNhapDuoc(request.resource.data) && anhPhuKien(request.resource.data)
        && (request.resource.data.trangThai == 'tam' || coQ('nh_duyet')));
      allow delete: if adm();
    }

    // ===== ĐẶT HÀNG NHÀ CUNG CẤP (chỉ trong app) =====
    // Đơn không chứa giá; giá vốn + thanh toán ở don_dat_hang_gia, chỉ người có quyền mới đọc / ghi.
    match /nha_cung_cap/{id} {
      allow read, create, update: if q('dathang');
      allow delete: if adm();
    }
    match /don_dat_hang/{id} {
      allow read: if q('dathang');
      allow create, update: if adm() || (coQ('dathang')
        && !request.resource.data.keys().hasAny(['gia', 'tongTien', 'thanhToan', 'daThanhToan']));
      allow delete: if adm();
    }
    match /don_dat_hang_gia/{id} {
      allow read: if q('dh_giavon') || q('dh_thanhtoan');
      allow create: if adm() || (coQ('dathang') && (
        (coQ('dh_giavon') && chiCo(['gia', 'tongTien', 'suaLuc']))
        || (coQ('dh_thanhtoan') && chiCo(['thanhToan', 'daThanhToan', 'suaLuc']))));
      allow update: if adm() || (coQ('dathang') && (
        (coQ('dh_giavon') && chiDoi(['gia', 'tongTien', 'suaLuc']))
        || (coQ('dh_thanhtoan') && chiDoi(['thanhToan', 'daThanhToan', 'suaLuc']))));
      allow delete: if adm();
    }

    // ===== LỊCH SỬ THAO TÁC: ai đăng nhập cũng ghi được dòng của chính mình; chỉ Admin xem; không sửa, không xóa =====
    match /nhat_ky/{id} {
      allow create: if dn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['createdAt', 'uid', 'ten', 'vaiTro', 'man', 'hanhDong', 'nhom', 'chiTiet', 'soThayDoi', 'demo'])
        && request.resource.data.createdAt == request.time;
      allow read: if adm();
      allow update, delete: if false;
    }

    // ===== SỔ QUỸ (phiếu chi / thu) — nền cho quản lý dòng tiền =====
    // Không sửa, không xóa: chỉ được hủy (chuyển trạng thái, ghi lý do).
    // Mọi phiếu (bán hàng, trả hàng, đặt cọc, trả nhà cung cấp, phiếu tay), duyệt, hủy, kết ca: CHỈ máy chủ ghi
    // (máy chủ cộng/trừ số dư quỹ cùng lần ghi). Đọc: sq_xemtatca / sq_ketca / sq_duyet xem tất cả;
    // soquy chỉ phiếu mình tạo hoặc tiền mình đang giữ; dh_thanhtoan chỉ phiếu trả nhà cung cấp.
    function laPhieuNCC(d) { return d.get('thamChieu', {}).get('loai', '') == 'don_dat_hang'; }
    match /so_quy/{id} {
      allow read: if qMot(['sq_xemtatca', 'sq_ketca', 'sq_duyet'])
        || (q('soquy') && (resource.data.nguoi.uid == toi() || resource.data.get('giu', '') == toi()))
        || (q('dh_thanhtoan') && laPhieuNCC(resource.data));
      allow write: if false;
    }
    // Lịch sử kết ca: quản lý / Admin xem tất cả, nhân viên xem lần kết ca của mình; ghi chỉ qua máy chủ
    match /ket_ca/{id} {
      allow read: if q('sq_ketca') || (q('ketca') && resource.data.nhanVien.uid == toi());
      allow write: if false;
    }
    // Số dư 2 quỹ: chỉ máy chủ (Admin xem qua máy chủ)
    match /so_quy_cfg/{id} {
      allow read, write: if false;
    }

    // Báo cá mới về: đang tạm ẩn — chỉ Admin
    match /phieu_baoca/{id} {
      allow read, write: if adm();
    }

    // ===== CHECKLIST =====
    match /ca_benh/{id} {
      allow read, write: if q('checklist');
    }

    // ===== CA LÀM VIỆC / LỊCH / CHẤM CÔNG =====
    match /ca_lam_viec/{id} {
      allow read: if nv();
      allow write: if adm();
    }
    // Lịch công khai: chỉ tên + loại ca, ai cũng xem được lịch tuần
    match /lich_cong_khai/{id} {
      allow read: if nv();
      allow write: if q('lichca_xepca') || (nv() && request.resource.data.uid == toi());
    }
    // Chấm công chi tiết (ảnh, GPS, giờ vào/ra): mỗi người chỉ thấy ca của mình
    // trừ khi có quyền xem chấm công / xếp ca / xem lương mọi người / báo cáo
    match /lich_ca/{id} {
      allow get: if qMot(['cc_xemtatca', 'lichca_xepca', 'luong_xemtatca', 'bc_ngay'])
        || (nv() && id.matches('.*_' + toi()))
        || (nv() && resource.data.uid == toi());
      allow list: if qMot(['cc_xemtatca', 'lichca_xepca', 'luong_xemtatca', 'bc_ngay'])
        || (nv() && resource.data.uid == toi());
      // Tự chấm công ngoài lịch: tạo ca của chính mình
      allow create: if q('lichca_xepca') || (nv() && request.resource.data.uid == toi());
      allow update: if adm() || q('lichca_xepca')
        // Chấm công vào/ra và checklist trên ca của chính mình
        || (nv() && resource.data.uid == toi() && chiDoi(['vaoLuc', 'gpsOk', 'gpsDist', 'isMock', 'photo',
              'thoatLuc', 'thoatGpsOk', 'thoatGpsDist', 'thoatIsMock', 'thoatPhoto', 'khongCheckout', 'checklistData',
              // Ca gãy: vào / ra khung 2
              'vaoLuc2', 'gpsOk2', 'gpsDist2', 'isMock2', 'photo2',
              'thoatLuc2', 'thoatGpsOk2', 'thoatGpsDist2', 'thoatIsMock2', 'thoatPhoto2']))
        || (q('luong_duyet') && chiDoi(['lamThemDuyet']));
      allow delete: if adm();
    }

    // ===== LƯƠNG =====
    match /phu_cap/{id} {
      // Tài liệu đặt tên {tháng}_{uid}: đọc của mình được cả khi tháng đó chưa có phụ cấp
      allow get: if q('luong_xemtatca') || (q('luong') && id.matches('.*_' + toi()));
      allow list: if q('luong_xemtatca') || (q('luong') && resource.data.uid == toi());
      allow write: if adm();
    }
    match /khau_tru/{id} {
      allow read: if q('luong_xemtatca') || (q('luong') && resource.data.uid == toi());
      allow create: if q('luong_duyet');
      allow update, delete: if adm();
    }
    match /moc_hang_hong/{id} {
      // Nhân viên xem lương cần mốc để thấy thưởng / trừ hàng hỏng của mình
      allow read: if q('luong');
      allow write: if adm();
    }
    match /nhat_ky_dong_goi/{id} {
      allow read: if q('luong_xemtatca') || (q('luong') && resource.data.uid == toi());
      allow write: if adm();
    }

    // ===== SÀN TMĐT (quyền Sàn chỉ có trong thẻ khi Admin bật Sàn TMĐT) =====
    match /don_hang_san/{id} {
      allow read: if qMot(['tmdt_donhang', 'tmdt_hoantra', 'quetdonggoi', 'luong_xemtatca']);
      allow create, delete: if adm();
      allow update: if adm()
        // Đóng gói: chỉ ghi kết quả quét của chính mình, đơn chưa đóng gói
        || (q('quetdonggoi')
            && chiDoi(['trangThaiNoiBo', 'thoiGianDongGoi', 'nhanVienDongGoi', 'banDongGoi'])
            && request.resource.data.trangThaiNoiBo == 'da_dong_goi'
            && request.resource.data.nhanVienDongGoi == toi()
            && !('thoiGianDongGoi' in resource.data))
        // Xử lý đơn: chuẩn bị hàng, in vận đơn, xác nhận đơn
        || (q('tmdt_donhang')
            && chiDoi(['daChuanBiHang', 'chuanBiLuc', 'daThuChuanBi', 'thuChuanBiLuc', 'loiHeThongLuc',
                       'loiHeThongNoiDung', 'nhomChoTruoc', 'daInVanDon', 'inVanDonLuc', 'inVanDonBoi',
                       'sanTuChoiLuc', 'sanTuChoiLyDo']))
        // Đơn hủy / hoàn trả: nhận lại kiện, nhập lại kho. Nhập thiếu thì không tự xác nhận được.
        || (q('tmdt_hoantra')
            && chiDoi(['daNhanLaiKien', 'nhanLaiLuc', 'nguoiNhanLai',
                       'daNhapLaiKho', 'nhapLaiKhoLuc', 'nguoiNhapLaiKho',
                       'nhapLaiChiTiet', 'nhapLaiDayDu', 'nhapLaiThieu',
                       'nhapLaiGhiChu', 'daXacNhanNhapLai'])
            && (request.resource.data.get('daNhapLaiKho', false) != true
                || request.resource.data.get('daXacNhanNhapLai', false) == request.resource.data.get('nhapLaiDayDu', false)));
    }
    match /san_pham_dang/{id} {
      allow read: if qMot(['tmdt_donhang', 'tmdt_hoantra', 'quetdonggoi', 'tmdt_sanpham', 'tmdt_daytonkho']);
      allow update: if adm() || (q('tmdt_sanpham') && chiDoi(['skuCon']));
      allow create, delete: if adm();
    }

    // ===== CHỈ ADMIN =====
    match /nhat_ky_webhook/{id} {
      allow read: if adm();
      allow write: if false;
    }
    match /lien_ket_sku/{id} {
      allow read, write: if adm();
    }
    match /phieu_kiem_kho/{id} {
      allow read, write: if adm();
    }

    // Mọi thứ còn lại: chặn
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
